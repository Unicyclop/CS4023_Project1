<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="reactive_room">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Large floor -->
    <model name="floor">
      <static>true</static>
      <pose>2.286 3.048 -0.05 0 0 0</pose>

      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>8 10 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>8 10 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Top wall -->
    <model name="north_wall">
      <static>true</static>
      <pose>2.286 6.096 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.722 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.722 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Bottom hallway wall -->
    <model name="south_wall">
      <static>true</static>
      <pose>2.286 0 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.722 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.722 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Left outside wall -->
    <model name="west_wall">
      <static>true</static>
      <pose>0 3.048 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 6.246 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 6.246 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Right outside wall -->
    <model name="east_wall">
      <static>true</static>
      <pose>4.572 3.048 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 6.246 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 6.246 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Wall separating room from long hallway -->
    <model name="room_east_wall">
      <static>true</static>
      <pose>3.048 3.810 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 4.722 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 4.722 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Left side of room doorway -->
    <model name="room_south_wall_west">
      <static>true</static>
      <pose>0.3435 1.524 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.837 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.837 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Right side of room doorway -->
    <model name="room_south_wall_east">
      <static>true</static>
      <pose>2.7045 1.524 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.837 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.837 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
